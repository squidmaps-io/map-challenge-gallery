---
import Layout from '../layouts/Layout.astro';
import PlatformIcon from '../components/PlatformIcon';
import { ABOUT, inlineHtml } from '../lib/about-content';
import { aboutJsonLd } from '../lib/structured-data';
import { CONTACT_URL, withBase } from '../lib/site';

const link = 'font-semibold text-ink-600 underline decoration-ink-300 underline-offset-2 hover:text-ink-700 dark:text-ink-300';
const html = (text: string) => inlineHtml(text, link, CONTACT_URL);
---

<Layout
  title={ABOUT.title}
  description={ABOUT.description}
  path="/about/"
  markdownPath="/about.md"
  jsonLd={aboutJsonLd({ description: ABOUT.description })}
>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-4 sm:px-6 sm:pt-16">
    <p class="font-display text-sm font-extrabold tracking-widest text-ink-500 uppercase dark:text-ink-300">{ABOUT.eyebrow}</p>
    <h1 class="mt-2 font-display text-4xl font-black tracking-tight text-balance sm:text-5xl">{ABOUT.heading}</h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400" set:html={html(ABOUT.intro)} />

    <div class="mt-12 space-y-12">
      {ABOUT.sections.map((s) => (
        <section
          id={s.id}
          aria-labelledby={`${s.id}-heading`}
          class:list={['scroll-mt-24', s.id === 'contact' && 'rounded-2xl bg-ink-50 p-6 sm:p-8 dark:bg-ink-700/20']}
        >
          <h2 id={`${s.id}-heading`} class="font-display text-2xl font-extrabold">{s.heading}</h2>
          {s.id === 'why' && (
            <div class="mt-4 flex gap-2 text-zinc-600 dark:text-zinc-400" aria-hidden="true">
              <PlatformIcon platform="bluesky" className="size-6" />
              <PlatformIcon platform="mastodon" className="size-6" />
            </div>
          )}
          {s.lead && <p class="mt-3 text-zinc-600 dark:text-zinc-400" set:html={html(s.lead)} />}
          {s.steps && (
            <ol class="mt-4 grid gap-3 sm:grid-cols-2">
              {s.steps.map(([title, body], i) => (
                <li class="flex gap-3 rounded-xl bg-white p-4 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
                  <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink-500 font-display text-sm font-black text-white" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span>
                    <span class="font-semibold">{title}</span> <span class="text-zinc-600 dark:text-zinc-400">{body}</span>
                  </span>
                </li>
              ))}
            </ol>
          )}
          {s.points && (
            <ul class="mt-4 list-disc space-y-3 pl-5 text-zinc-700 marker:text-ink-500 dark:text-zinc-300">
              {s.points.map(([lead, rest]) => (
                <li>
                  <strong>{lead}</strong> {rest}
                </li>
              ))}
            </ul>
          )}
          {s.after?.map((p) => <p class="mt-4 text-zinc-700 dark:text-zinc-300" set:html={html(p)} />)}
          {s.note && <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400" set:html={html(s.note)} />}
        </section>
      ))}
    </div>

    <p class="mt-12 text-center">
      <a href={withBase('/')} class="inline-flex rounded-full bg-ink-500 px-5 py-2.5 font-bold text-white hover:bg-ink-600">Browse the gallery →</a>
    </p>
  </article>
</Layout>
