---
import { postsForDay, themes } from '../lib/data';
import { YEAR, withBase } from '../lib/site';

interface Props {
  variant?: 'full' | 'mini';
  current?: number;
}
const { variant = 'full', current } = Astro.props;
const mini = variant === 'mini';

const WEEKDAYS = mini ? ['S', 'M', 'T', 'W', 'T', 'F', 'S'] : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const offset = new Date(Date.UTC(YEAR, 10, 1)).getUTCDay(); // weekday of Nov 1
const days = themes.map((t) => ({ ...t, posts: postsForDay(t.day) }));

// Soft hyphens so long theme names break cleanly in small calendar cells.
const SOFT: Record<string, string> = {
  Collaborative: 'Collab\u00ADorative',
  Interactions: 'Inter\u00ADactions',
  OpenStreetMap: 'OpenStreet\u00ADMap',
  Borgesian: 'Borges\u00ADian',
  Projections: 'Projec\u00ADtions',
  Prompting: 'Prompt\u00ADing',
  Hexagons: 'Hexa\u00ADgons',
  Polygons: 'Poly\u00ADgons',
  Clusters: 'Clus\u00ADters',
};
const soft = (theme: string) => theme.replace(/[A-Za-z]+/g, (w) => SOFT[w] ?? w);
---

<div class:list={[mini ? 'w-full max-w-[19rem]' : 'w-full']} data-calendar data-year={YEAR}>
  {mini && <p class="mb-2 font-display text-sm font-extrabold">November {YEAR}</p>}
  <div class:list={['grid grid-cols-7', mini ? 'gap-1' : 'gap-1.5 sm:gap-3']}>
    {WEEKDAYS.map((w) => (
      <div aria-hidden="true" class:list={['text-center font-display font-bold text-zinc-600 dark:text-zinc-400', mini ? 'text-[11px]' : 'pb-1 text-xs tracking-wider uppercase']}>{w}</div>
    ))}
    {Array.from({ length: offset }, () => <div aria-hidden="true" />)}

    {days.map(({ day, theme, posts }) => {
      const active = day === current;
      const empty = posts.length === 0;
      const cover = posts[0];
      // A pool of covers the browser picks from at random on each page load.
      const pool = JSON.stringify(
        [...posts]
          .sort((a, b) => a.id.localeCompare(b.id))
          .slice(0, mini ? 6 : 12)
          .map((p) => [p.image, p.color ?? '']),
      );
      const label = `Day ${day}: ${theme}, ${empty ? 'coming soon' : `${posts.length} maps`}`;
      // Keep tooltips on screen at the calendar's edges.
      const col = (offset + day - 1) % 7;
      const align = col === 0 ? 'left-0' : col === 6 ? 'right-0' : 'left-1/2 -translate-x-1/2';
      const arrow = col === 0 ? 'left-4' : col === 6 ? 'right-4' : 'left-1/2 -translate-x-1/2';

      const tooltip = (
        <div
          aria-hidden="true"
          id={`cal-tip-${variant}-${day}`}
          class:list={[
            'pointer-events-none absolute bottom-full z-20 mb-2 w-max max-w-[12rem] translate-y-1 rounded-lg bg-zinc-900 px-3 py-2 text-left text-white opacity-0 shadow-lg ring-1 ring-white/10 transition duration-150',
            'group-hover/cell:translate-y-0 group-hover/cell:opacity-100 group-focus-within/cell:translate-y-0 group-focus-within/cell:opacity-100',
            'dark:bg-zinc-100 dark:text-zinc-900 dark:ring-black/10',
            align,
          ]}
        >
          <p class="font-display text-[11px] font-bold tracking-wider text-ink-300 uppercase dark:text-ink-600">Day {day}</p>
          <p class="font-display text-sm leading-tight font-extrabold">{theme}</p>
          <p class="mt-0.5 text-xs text-white/75 dark:text-zinc-600">{empty ? 'Coming soon' : `${posts.length} maps`}</p>
          <span class:list={['absolute top-full -mt-1 size-2 rotate-45 bg-zinc-900 dark:bg-zinc-100', arrow]} aria-hidden="true" />
        </div>
      );

      if (mini) {
        return (
          <div class="group/cell relative">
            <a
              href={withBase(`day/${day}/`)}
              aria-label={label}
              aria-current={active ? 'page' : undefined}
              data-day={day}
              data-pool={cover && !active ? pool : undefined}
              class:list={[
                'relative grid aspect-square place-items-center overflow-hidden rounded-md font-display text-[13px] font-extrabold transition',
                active
                  ? 'bg-ink-500 text-white ring-2 ring-ink-500 ring-offset-2 ring-offset-[#f5f7f6] dark:ring-offset-zinc-950'
                  : empty
                    ? 'bg-zinc-100 text-zinc-600 hover:bg-zinc-200 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800'
                    : 'bg-zinc-200 text-white hover:ring-2 hover:ring-ink-400 dark:bg-zinc-800',
              ]}
            >
              {cover && !active && (
                <>
                  <img src={cover.image} alt="" loading="lazy" referrerpolicy="no-referrer" data-cover class="absolute inset-0 size-full object-cover" />
                  <span class="absolute inset-0 bg-black/45" />
                </>
              )}
              <span class="relative">{day}</span>
            </a>
            {tooltip}
          </div>
        );
      }

      return (
        <div class="group/cell relative">
          <a
            href={withBase(`day/${day}/`)}
            aria-label={label}
            data-day={day}
            data-pool={empty ? undefined : pool}
            class:list={[
              'group relative block aspect-square overflow-hidden rounded-lg bg-zinc-200/70 ring-ink-500 transition hover:ring-2 sm:rounded-xl dark:bg-zinc-900',
              empty && 'bg-zinc-100 dark:bg-zinc-900/60',
            ]}
          >
            {posts.length >= 4 ? (
              <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-px">
                {posts.slice(0, 4).map((p) => (
                  <img src={p.image} alt="" loading="lazy" referrerpolicy="no-referrer" width="240" height="240" data-cover class="size-full object-cover transition duration-500 group-hover:scale-105" style={`background:${p.color}`} />
                ))}
              </div>
            ) : cover ? (
              <img src={cover.image} alt="" loading="lazy" referrerpolicy="no-referrer" data-cover class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105" />
            ) : null}

            {!empty && <span class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.55),rgb(0_0_0/0.05)_40%,rgb(0_0_0/0.1)_55%,rgb(0_0_0/0.85))]" />}

            <div class:list={['absolute inset-0 flex flex-col justify-between p-1.5 sm:p-3', empty ? 'text-zinc-600 dark:text-zinc-400' : 'text-white']}>
              <span class="font-display text-base leading-none font-black sm:text-3xl">{day}</span>
              <div class="min-w-0">
                <p class="line-clamp-2 font-display text-[9px] leading-[1.15] font-extrabold hyphens-manual sm:text-[13px] sm:leading-tight md:text-sm">{soft(theme)}</p>
                <p class:list={['hidden text-xs sm:block', empty ? 'text-zinc-600 dark:text-zinc-400' : 'text-white/75']}>{empty ? 'Coming soon' : `${posts.length} maps`}</p>
              </div>
            </div>
          </a>
          {tooltip}
        </div>
      );
    })}
  </div>
</div>

<script is:inline>
  // Shuffle each day's cover images so the calendar looks different on every visit.
  (function () {
    var cells = document.currentScript.previousElementSibling.querySelectorAll('[data-pool]');
    cells.forEach(function (cell) {
      var pool = JSON.parse(cell.getAttribute('data-pool'));
      for (var i = pool.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
      }
      var imgs = cell.querySelectorAll('img[data-cover]');
      var next = imgs.length;
      imgs.forEach(function (img, i) {
        // Images load from the original platform; if one fails, try the next map in the pool.
        img.onerror = function () {
          if (next < pool.length) {
            img.src = pool[next][0];
            next++;
          } else {
            img.style.visibility = 'hidden';
          }
        };
        if (!pool[i]) return;
        img.src = pool[i][0];
        if (pool[i][1]) img.style.background = pool[i][1];
      });
    });
  })();
</script>

<script>
  // Outline today's cell (computed in the browser so the static build doesn't go stale).
  const now = new Date();
  const cal = document.querySelector<HTMLElement>('[data-calendar]');
  if (cal && now.getMonth() === 10 && String(now.getFullYear()) === cal.dataset.year) {
    document.querySelectorAll<HTMLElement>(`[data-calendar] [data-day="${now.getDate()}"]`).forEach((el) => {
      if (el.getAttribute('aria-current') !== 'page') el.classList.add('outline-2', 'outline-offset-2', 'outline-ink-400', 'outline-dashed');
      el.dataset.today = '';
    });
  }
</script>
